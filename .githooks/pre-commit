#!/bin/sh
# Format locally, never stage or commit changes on the user's behalf.
set -eu
cd "$(git rev-parse --show-toplevel)"

if ! command -v cargo >/dev/null 2>&1; then
    echo 'pre-commit: cargo is required' >&2
    exit 1
fi

if cargo fmt --all -- --check; then
    exit 0
fi

echo 'pre-commit: running cargo fmt --all locally...' >&2
cargo fmt --all
echo 'pre-commit: review and stage the formatting changes before committing again.' >&2
exit 1
